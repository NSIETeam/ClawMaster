{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-drag",
  "description": "Lets the Host Web UI act as the window drag region while the macOS title bar is an overlay.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
