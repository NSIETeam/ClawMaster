{
  "name": "clawmaster-desktop",
  "version": "0.0.2-beta.1",
  "description": "ClawMaster Desktop app shell for the ClawMaster agent runtime",
  "author": "NSIETeam",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build:native": "npm run build --workspace=@clawmaster/native",
    "build:renderer": "webpack-cli --config webpack.config.cjs --mode production && node --test scripts/renderer-static-css.check.mjs",
    "build": "npm run build:renderer && npm run tauri:native:verify",
    "tauri:dev": "tauri dev",
    "tauri:native:verify": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "ui:smoke": "node scripts/smoke-product-ui.mjs",
    "tauri:runtime:verify": "node scripts/verify-tauri-bundle.mjs",
    "tauri:dmg:create": "node scripts/create-tauri-dmg.mjs",
    "tauri:dmg:optimize": "node scripts/optimize-tauri-dmg.mjs",
    "tauri:dmg:verify": "node scripts/verify-tauri-dmg.mjs",
    "tauri:build": "node scripts/build-tauri-release.mjs",
    "tauri:windows:verify": "node scripts/verify-tauri-windows-installer.mjs",
    "dev:renderer": "webpack-cli --config webpack.config.cjs --mode development --watch",
    "start": "npm run tauri:dev",
    "visual:inventory": "node scripts/visual-asset-inventory.mjs",
    "dist": "npm run tauri:build",
    "dist:dmg": "npm run tauri:build",
    "dist:win": "npm run tauri:build",
    "package": "npm run tauri:build",
    "legacy:build:main": "npm run build:native && tsc -p tsconfig.main.json",
    "legacy:build:preload": "tsc -p tsconfig.preload.json --noEmit && webpack-cli --config webpack.preload.cjs --mode production && node scripts/verify-preload-bundle.mjs",
    "legacy:build": "npm run legacy:build:main && npm run legacy:build:preload && npm run build:renderer",
    "legacy:start": "npm run legacy:build && electron dist/main/index.js",
    "legacy:dist:mac": "npm run legacy:build && electron-builder --mac --dir",
    "legacy:dist:portable:win": "node scripts/fetch-win-ripgrep.mjs && npm run legacy:build && electron-builder --win --x64 --publish never && node scripts/portable-usb.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "pretest": "npm run build --workspace=clawmaster-server && npm run build:native",
    "test": "vitest run",
    "pretypecheck": "npm run build:native",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:legacy": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "release": "npm run tauri:build",
    "release:gate": "node scripts/formal-tauri-release-gate.mjs",
    "release:formal:gate": "node scripts/formal-tauri-release-gate.mjs",
    "release:beta:gate": "node scripts/beta-tauri-release-gate.mjs",
    "release:legacy:electron": "node scripts/make-delivery-zip.mjs --build",
    "release:legacy:gate": "node scripts/release-recovery-gate.mjs"
  },
  "dependencies": {
    "@clawmaster/native": "file:../../clawmaster-native",
    "motion": "^13.1.1",
    "clawmaster-server": "file:../server",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "playwright-core": "1.62.1",
    "ts-loader": "^9.5.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "team.nsi.clawmaster.desktop",
    "productName": "ClawMaster",
    "copyright": "Copyright © 2026 NSIETeam",
    "protocols": [
      {
        "name": "ClawMaster 企业邀请",
        "schemes": [
          "clawmaster"
        ]
      }
    ],
    "electronVersion": "43.2.0",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/tests/**",
      "!**/node_modules/**/__tests__/**",
      "!**/node_modules/**/docs/**",
      "!**/node_modules/**/doc/**",
      "!**/node_modules/**/examples/**",
      "!**/node_modules/**/example/**",
      "!**/node_modules/@vscode/ripgrep/**",
      "!**/node_modules/@larksuiteoapi/node-sdk/es/**",
      "!**/node_modules/@larksuiteoapi/node-sdk/types/**",
      "!**/node_modules/js-tiktoken/dist/**/*.cjs",
      "!**/node_modules/@clawmaster/native/target/**",
      "!**/node_modules/@clawmaster/native/src/**",
      "!**/node_modules/@clawmaster/native/Cargo.*",
      "!**/node_modules/@clawmaster/native/tsconfig.json",
      "!**/node_modules/better-sqlite3/deps/**",
      "!**/node_modules/better-sqlite3/prebuilds/**",
      "!**/node_modules/better-sqlite3/src/**",
      "!**/node_modules/better-sqlite3/build/deps/**",
      "!**/node_modules/better-sqlite3/build/Release/obj/**",
      "!**/node_modules/better-sqlite3/build/Release/test_extension.node",
      "!**/node_modules/npm/**",
      "!**/node_modules/corepack/**",
      "!**/node_modules/electron/**",
      "!**/node_modules/electron-builder/**",
      "!**/node_modules/typescript/**",
      "!**/node_modules/webpack/**",
      "!**/node_modules/webpack-cli/**",
      "!**/node_modules/eslint/**",
      "!**/node_modules/vitest/**",
      "!**/coverage/**",
      "!**/junit.xml",
      "!**/*.tsbuildinfo",
      "!**/*.test.*",
      "!**/__tests__/**"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@clawmaster/native/bin/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "artifactName": "ClawMaster-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ClawMaster 使用麦克风将语音转换为聊天输入文字。"
      },
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "app-icon.png"
        },
        {
          "from": "../../node_modules/@vscode/ripgrep/bin/rg",
          "to": "ripgrep/rg"
        }
      ]
    },
    "dmg": {
      "sign": true,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "app-icon.png"
        },
        {
          "from": "vendor/win/ripgrep/rg.exe",
          "to": "ripgrep/rg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ClawMaster",
      "artifactName": "ClawMaster-Setup-${version}-win-x64.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
