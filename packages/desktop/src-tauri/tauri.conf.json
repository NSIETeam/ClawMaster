{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawMaster",
  "version": "0.0.2-beta.3",
  "identifier": "team.nsi.clawmaster.desktop",
  "build": {
    "beforeDevCommand": "npm run build:renderer",
    "beforeBuildCommand": "npm run build:renderer && npm run tauri:native:verify",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; frame-src 'self'; img-src 'self' asset: http: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "ClawMaster",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {},
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 NSIETeam",
    "icon": [
      "../build/icon.png",
      "../build/icon.icns",
      "../build/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "shortDescription": "ClawMaster AI coworker and coding agent",
    "targets": "all"
  }
}
